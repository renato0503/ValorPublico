# Caminho absoluto para a chave de conta de serviço (JSON) do Firebase
# Baixada em: Console Firebase > Configuracoes do projeto > Contas de servico > Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT=C:/caminho/para/valor-publico-firebase-adminsdk.json

# URL do banco (aba "Firestore Database")
FIREBASE_DATABASE_URL=https://valor-publico.firebaseio.com

# Credenciais opcionais de sessao para Instagram (evitar bloqueios)
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# Pool de proxies (um por linha, separado por virgula)
PROXY_LIST=

# Delay aleatorio minimo/maximo entre requisicoes (segundos)
SCRAPE_DELAY_MIN=2
SCRAPE_DELAY_MAX=6