# Caminho absoluto para a chave de conta de serviço (JSON) do Firebase
# Baixada em: Console Firebase > Configuracoes do projeto > Contas de servico > Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT=C:/caminho/para/valor-publico-firebase-adminsdk.json

# URL do banco (aba "Firestore Database")
FIREBASE_DATABASE_URL=https://valor-publico.firebaseio.com

# Credenciais opcionais de sessao para Instagram (evitar bloqueios)
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
# Arquivo de sessao gerado apos login (instaloader-session-<user>)
INSTAGRAM_SESSION_FILE=
# Limite conservador de posts por perfil (instaloader ban por IP em escala)
INSTAGRAM_MAX_POSTS_PERFIL=20

# Facebook (extracao via Playwright - lib facebook-scraper e morta desde 2022)
# Cookies do navegador no formato Netscape (cookies.txt) ou JSON
FACEBOOK_COOKIES_FILE=
# Login alternativo (fallback)
FACEBOOK_USERNAME=
FACEBOOK_PASSWORD=
# Rodar navegador em modo headless (1=sim, 0=nao)
FACEBOOK_HEADLESS=1
FACEBOOK_MAX_ROLAGENS=5

# Contas do Twitter/X para o pool do twscrape: "user:pass:email;user2:pass2:email2"
TWITTER_ACCOUNTS=
# Cookies reais do navegador (auth_token, ct0) em JSON: {"user": {"auth_token": "..", "ct0": ".."}}
# Recomendado: resiste a banimentos e permite rotacao automatica em HTTP 429.
TWITTER_COOKIES_FILE=

# YouTube (yt-dlp + youtube-transcript-api)
# Inclui transcricao das falas (rica p/ sentimento)
YOUTUBE_COLETAR_TRANSCRICAO=1
YOUTUBE_MAX_VIDEOS=5

# Telegram (Telethon - MTProto autenticado; nunca clones do Pyrogram)
# Obtenha api_id/api_hash em https://my.telegram.org
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
# Numero (com DDI) usado no primeiro login (ex.: 5567993515206)
TELEGRAM_PHONE=
# Arquivo de sessao gerado apos o primeiro login
TELEGRAM_SESSION_FILE=
# Canais/grupos publicos a monitorar (separados por virgula)
TELEGRAM_CANAIS=
TELEGRAM_LIMITE_POR_CANAL=50
# Primeiro login (gera a sessao): python scripts/login_telegram.py

# TV / Radio (Sprint 13) - transcricao de falas via canais de noticia no YouTube
# Formato: "@canal" ou "c/UCxxxx" (identificador aceito pelo yt-dlp)
# Canais de TV de Cuiaba/VG: TV Vila Real (Record), TV Centro America (Globo),
# TV Rondon (SBT), TV Cidade Verde (Band)
# Radios com jornalismo local: Centro America FM, CBN Cuiaba (@cbncba),
# BandNews FM Cuiaba
HABILITAR_TV=1
HABILITAR_RADIO=1
TV_CANAIS=@tvvilareal,@tvcentroamerica,@TVRondon,@tvcidadeverde
RADIO_CANAIS=@centroamericafm,@cbncba,@bandnewsfmcuiaba
# Limite de videos recentes checados por canal (transcricao e lenta).
# Ampliar a janela aumenta a chance de capturar telejornais que citam vereadores.
MIDIA_VIDEOS_POR_CANAL=10

# Impresso (Sprint 13) - jornais impressos com edicao digital
# URLs base (homepage ou RSS) separadas por virgula
HABILITAR_IMPRESSO=1
IMPRESSO_SITES=https://www.caldeiraopolitico.com.br,https://www.folhamax.com,https://www.olhardireto.com.br,https://g1.globo.com/mato-grosso,https://www.odiariomt.com.br

# Pool de proxies (um por linha, separado por virgula)
PROXY_LIST=

# Delay aleatorio minimo/maximo entre requisicoes (segundos)
SCRAPE_DELAY_MIN=2
SCRAPE_DELAY_MAX=6

# Coleta comentarios junto com as postagens (1=sim, 0=nao)
INCLUIR_COMENTARIOS=1

# Limite de itens coletados por agente e threads paralelas
LIMITE_ITENS_POR_AGENTE=50
MAX_WORKERS=8

# Liga/desliga scrapers individualmente (1=ligado, 0=desligado)
HABILITAR_TWITTER=1
HABILITAR_INSTAGRAM=1
HABILITAR_FACEBOOK=1
HABILITAR_WEB=1
HABILITAR_YOUTUBE=1
HABILITAR_TELEGRAM=1
HABILITAR_TV=1
HABILITAR_RADIO=1
HABILITAR_IMPRESSO=1

# Avaliacao IA do sentimento (alternativa ao VADER).
# Endpoint OpenAI-compativel (OpenAI, Groq, Ollama, LM Studio, etc.).
# Sem IA_SENTIMENTO_API_KEY o pipeline usa VADER + lexico PT.
IA_SENTIMENTO_ENABLED=0
IA_SENTIMENTO_BASE_URL=https://api.openai.com/v1
IA_SENTIMENTO_API_KEY=
IA_SENTIMENTO_MODEL=gpt-4o-mini
# Limite de itens por execucao (controle de custo) e tamanho do lote por chamada
IA_SENTIMENTO_MAX_ITENS=200
IA_SENTIMENTO_TAMANHO_LOTE=20
IA_SENTIMENTO_TIMEOUT=30
IA_SENTIMENTO_TEMPERATURA=0.0

# ---------------------------------------------------------------------------
# Camada DSM: radar de propaganda publica, compliance eleitoral, alertas,
# cobertura/SLA e newsletter.
# ---------------------------------------------------------------------------

# Fontes oficiais/institucionais do radar (URLs separadas por virgula).
# PADRAO (se vazio): lista curada e verificada em backend/config/fontes_radar.py
#   Cuiaba ............ Prefeitura de Cuiaba + Camara Municipal de Cuiaba
#   Varzea Grande ..... Prefeitura (feed oficial), transparencia e DOE
#   ALMT / Estado ..... DOE-MT (IOnews), Secom-MT, CGE-MT e Transparecia MT
# Para usar outra lista, informe as URLs aqui (substitui o padrao).
FONTES_PROPAGANDA_PUBLICA=
# 1 = coleta o radar de propaganda publica a cada execucao da rotina
HABILITAR_PROPAGANDA_PUBLICA=1
PROPAGANDA_PUBLICA_MAX_ITENS=20

# Veiculos de alto impacto (Tier 1) - SLA, alertas e priorizacao de escopo.
TIER1_VEICULOS=
# Veiculos que o escopo se compromete a monitorar (faltantes aparecem no painel).
VEICULOS_ESPERADOS=

# Limiar (R$) para alerta de mencao direta de alto valor.
ALERTA_VALOR_ALTO=1500

# Compliance eleitoral (Lei 9.504/1997) e calendario do ciclo.
COMPLIANCE_ELEITORAL_ENABLED=1
ELEICAO_ANO=2026
ELEICAO_1O_TURNO=
ELEICAO_2O_TURNO=

# Newsletter consolidada (HTML + texto para WhatsApp).
NEWSLETTER_ENABLED=1
NEWSLETTER_WEBHOOK=
NEWSLETTER_MAX_ITENS=15
NEWSLETTER_ASSINATURA=

# ---------------------------------------------------------------------------
# Entrega de alertas (e-mail SMTP + webhook) e configuracoes de relatorio.
# ---------------------------------------------------------------------------

# Nivel minimo para envio automatico: info | atencao | alto | critico
ALERTA_NIVEL_MINIMO=alto
# Webhook para entrega (Make/Zapier/n8n -> WhatsApp, Telegram, Slack...)
ALERTA_WEBHOOK_URL=
ALERTA_WEBHOOK_SECRET=
# Destinatarios fixos (e-mail). Vazio = nao envia e-mail (so painel/webhook).
ALERTA_DESTINATARIOS=

# Envio por e-mail (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=1
EMAIL_FROM=
EMAIL_PARA=

# Relatorio PDF
PDF_ASSINATURA=
PDF_INCLUIR_CAMADA_DSM=1
