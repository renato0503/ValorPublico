# Caminho absoluto para a chave de conta de serviço (JSON) do Firebase
# Baixada em: Console Firebase > Configuracoes do projeto > Contas de servico > Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT=C:/caminho/para/valor-publico-firebase-adminsdk.json

# URL do banco (aba "Firestore Database")
FIREBASE_DATABASE_URL=https://valor-publico.firebaseio.com

# Credenciais opcionais de sessao para Instagram (evitar bloqueios)
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
# Arquivo de sessao gerado apos login (instaloader-session-<user>)
INSTAGRAM_SESSION_FILE=
# Limite conservador de posts por perfil (instaloader ban por IP em escala)
INSTAGRAM_MAX_POSTS_PERFIL=20

# Facebook (extracao via Playwright - lib facebook-scraper e morta desde 2022)
# Cookies do navegador no formato Netscape (cookies.txt) ou JSON
FACEBOOK_COOKIES_FILE=
# Login alternativo (fallback)
FACEBOOK_USERNAME=
FACEBOOK_PASSWORD=
# Rodar navegador em modo headless (1=sim, 0=nao)
FACEBOOK_HEADLESS=1
FACEBOOK_MAX_ROLAGENS=5

# Contas do Twitter/X para o pool do twscrape: "user:pass:email;user2:pass2:email2"
TWITTER_ACCOUNTS=
# Cookies reais do navegador (auth_token, ct0) em JSON: {"user": {"auth_token": "..", "ct0": ".."}}
# Recomendado: resiste a banimentos e permite rotacao automatica em HTTP 429.
TWITTER_COOKIES_FILE=

# Pool de proxies (um por linha, separado por virgula)
PROXY_LIST=

# Delay aleatorio minimo/maximo entre requisicoes (segundos)
SCRAPE_DELAY_MIN=2
SCRAPE_DELAY_MAX=6

# Coleta comentarios junto com as postagens (1=sim, 0=nao)
INCLUIR_COMENTARIOS=1

# Limite de itens coletados por agente e threads paralelas
LIMITE_ITENS_POR_AGENTE=50
MAX_WORKERS=8

# Liga/desliga scrapers individualmente (1=ligado, 0=desligado)
HABILITAR_TWITTER=1
HABILITAR_INSTAGRAM=1
HABILITAR_FACEBOOK=1
HABILITAR_WEB=1