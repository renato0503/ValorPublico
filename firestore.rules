rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------------
    // Regras de Seguranca (RBAC) - Assessor Publico
    // ---------------------------------------------------------------
    // O dashboard PWA le dados agregados. Toda escrita e feita pelo backend
    // via Admin SDK (que ignora estas regras).
    //
    // MODO DE ACESSO (documento `config_acesso/publico`):
    //   publico = true  -> painel aberto (demo/comercializacao)
    //   publico = false -> exige login; cada usuario ve apenas o escopo
    //                      do proprio agente (colecao `usuarios`).
    //
    // Perfil do usuario (usuarios/{uid}):
    //   {email, papel, agente_id, agente_ids: [...], chaves: [...]}
    //   - agente_id  : id do agente (usado em metricas_por_agente/{id})
    //   - agente_ids : lista de ids de agentes permitidos
    //   - chaves     : chaves de escopo ("agente-<id>") da Camada DSM
    // ---------------------------------------------------------------

    function acessoPublico() {
      return get(/databases/$(database)/documents/config_acesso/publico).data.publico == true;
    }

    function perfilUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function usuarioComAcesso() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    // Administradores enxergam qualquer escopo (operacao do painel).
    function usuarioEhAdmin() {
      return usuarioComAcesso()
        && perfilUsuario().papel in ['admin', 'owner'];
    }

    // O usuario e dono do agente (id puro, ex.: "fulano-de-tal")
    function usuarioEhDonoDoAgente(agenteId) {
      return usuarioEhAdmin()
        || (usuarioComAcesso() && perfilUsuario().agente_ids.hasAny([agenteId]));
    }

    // O usuario e dono do escopo ("agente-<id>", "cidade-<slug>", "geral")
    function usuarioEhDonoDoEscopo(chave) {
      return usuarioComAcesso()
        && perfilUsuario().chaves.hasAny([chave]);
    }

    // ------------------------------------------------------------------
    // Orgão (separação total dos dados entre instituições)
    // ------------------------------------------------------------------
    // Cada usuário pertence a UM órgão: Câmara de Cuiabá, Câmara de Várzea
    // Grande, Assembleia Legislativa (ALMT) ou Governo de Mato Grosso.
    // O campo fica em `usuarios/{uid}.orgao`.
    function orgaoDoUsuario() {
      return usuarioComAcesso() ? perfilUsuario().orgao : "";
    }

    // Órgão gravado no próprio documento (agregados, DSM, lexical, ...).
    function orgaoDoDoc() {
      return resource.data.get('orgao', '');
    }

    // Órgão dono de um documento de agregado (mapa fixo, sem dicionário).
    // IDs de `metricas_por_casa`: camara-cuiaba, camara-vg, almt, governo-mt.
    // IDs de `metricas_por_cidade`: cuiaba, varzea-grande, mato-grosso, governo-de-mato-grosso.
    function orgaoDoDocumento(docId) {
      return docId == 'camara-cuiaba' ? 'cuiaba'
        : docId == 'camara-vg' ? 'varzea-grande'
        : docId == 'almt' ? 'almt'
        : docId == 'governo-mt' ? 'governo-mt'
        : docId == 'cuiaba' ? 'cuiaba'
        : docId == 'varzea-grande' ? 'varzea-grande'
        : docId == 'mato-grosso' ? 'almt'
        : docId == 'governo-de-mato-grosso' ? 'governo-mt'
        : '';
    }

    // Verdadeiro quando o usuario pode ler o agregado deste orgao.
    // Aceita o mapa por id (metricas_por_cidade/casa) ou o campo `orgao`.
    function orgaoPermitido(docId) {
      return usuarioEhAdmin()
        || (orgaoDoUsuario() != ''
            && (orgaoDoUsuario() == orgaoDoDocumento(docId)
                || orgaoDoUsuario() == orgaoDoDoc()));
    }

    // Leitura de um documento "por escopo" (geral | cidade-<slug> | agente-<id>).
    // Regras do Firestore exigem expressao unica por funcao (sem if/else).
    function leituraPorEscopo(chave) {
      // `geral` agrega todos os orgaos: so o administrador le.
      return acessoPublico()
        || (request.auth != null
            && (usuarioEhAdmin()
                || (chave != 'geral' && usuarioEhDonoDoEscopo(chave))
                || (orgaoDoUsuario() != '' && orgaoDoUsuario() == orgaoDoDoc())));
    }

    // Documento de configuracao de acesso (somente backend escreve)
    match /config_acesso/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Agentes publicos (roster) - leitura do orgao do usuario.
    // Clippings ficam em subcolecao e NAO sao expostos ao cliente.
    match /agentes_publicos/{docId} {
      allow read: if acessoPublico()
        || usuarioEhAdmin()
        || (usuarioComAcesso()
            && orgaoDoUsuario() != ''
            && orgaoDoUsuario() == orgaoDoDoc());
      allow write: if false;

      match /clippings/{clipId} {
        allow read, write: if false;
      }
    }

    // Metricas agregadas - leitura publica (dashboard em tempo real).
    // `metricas/geral` agrega TODOS os orgaos: so o administrador le.
    match /metricas/{docId} {
      allow read: if acessoPublico() || usuarioEhAdmin();
      allow write: if false;
    }

    match /metricas_por_cidade/{docId} {
      allow read: if acessoPublico() || orgaoPermitido(docId);
      allow write: if false;
    }

    // Metricas por agente: escopo do proprio agente quando o acesso e restrito.
    // Tambem visivel para quem e do mesmo orgao (a Casa ve os seus membros).
    match /metricas_por_agente/{docId} {
      allow read: if acessoPublico()
        || usuarioEhDonoDoAgente(docId)
        || (usuarioComAcesso()
            && orgaoDoUsuario() != ''
            && orgaoDoUsuario() == orgaoDoDoc());
      allow write: if false;
    }

    match /metricas_diarias/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Analises lexicais (IRAMUTEQ) publicadas pelo backend.
    match /analise_lexical/{docId} {
      allow read: if leituraPorEscopo(docId);
      allow write: if false;
    }

    // Releases de IA (resumo executivo por escopo/período).
    match /releases_ia/{docId} {
      allow read: if leituraPorEscopo(docId);
      allow write: if false;
    }

    // Tabela de valoracao (CPM + veiculos) - leitura publica.
    match /tabela_midia/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // Camada DSM: radar de propaganda publica, alertas e cobertura/SLA
    // ------------------------------------------------------------------
    // Radar de propaganda publica/institucional (transparencia e prova).
    match /radares/{docId} {
      allow read: if leituraPorEscopo(docId);
      allow write: if false;
    }

    // Alertas acionaveis (negativa direta, compliance eleitoral, valor alto).
    match /alertas/{docId} {
      allow read: if leituraPorEscopo(docId);
      allow write: if false;
    }

    // Cobertura e SLA do monitoramento (latencia, veiculos por tier, falhas).
    match /cobertura/{docId} {
      allow read: if leituraPorEscopo(docId);
      allow write: if false;
    }

    // Newsletter consolidada (HTML + texto para WhatsApp).
    match /newsletters/{docId} {
      allow read: if leituraPorEscopo(docId);
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // Plano 18 — imagens dos posts (I0–I5)
    // ------------------------------------------------------------------
    // `imagens/{phash}`: analise de cada imagem unica (OCR, tipo de peca, VLM,
    // reuso, C2PA). **Privada**: so o backend (Admin SDK) le e escreve.
    match /imagens/{docId} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // Plano 09/10 — relatorio e discurso da semana
    // ------------------------------------------------------------------
    // `relatorio_semanal/{escopo}__{semana}` e `discurso_semanal/{escopo}__{semana}`:
    // leitura por escopo (o dono do agente ou a casa com papel).
    match /relatorio_semanal/{docId} {
      allow read: if resource.data.escopo != null && leituraPorEscopo(resource.data.escopo);
      allow write: if false;
    }

    match /discurso_semanal/{docId} {
      allow read: if resource.data.escopo != null && leituraPorEscopo(resource.data.escopo);
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // Simulação (MiroFish/personas) e perfis das personas
    // ------------------------------------------------------------------
    // `simulacao_semanal/{escopo}__{semana}`: relatório de recepção.
    // `personas/{id}`: perfil sintético; leitura só do órgão/admin.
    match /simulacao_semanal/{docId} {
      allow read: if acessoPublico()
        || usuarioEhAdmin()
        || (usuarioComAcesso()
            && orgaoDoUsuario() != ''
            && orgaoDoUsuario() == orgaoDoDoc());
      allow write: if false;
    }

    match /personas/{docId} {
      allow read: if acessoPublico()
        || usuarioEhAdmin()
        || (usuarioComAcesso()
            && orgaoDoUsuario() != ''
            && orgaoDoUsuario() == orgaoDoDoc());
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // Plano 13 — fila de demandas (Base / Ouvidoria)
    // ------------------------------------------------------------------
    // `demandas/{id}`: pedido do cidadao. **Privado por escopo**: o gabinete
    // (Assessor) ou a Ouvidoria da casa (Valor) veem os pedidos do seu escopo.
    match /demandas/{docId} {
      allow read: if usuarioEhDonoDoEscopo(docId)
                   || (usuarioComAcesso()
                       && orgaoDoUsuario() != ''
                       && orgaoDoUsuario() == orgaoDoDoc())
                   || (usuarioComAcesso() && perfilUsuario().papel in
                       ['admin', 'owner', 'ouvidoria', 'secom', 'transparencia']);
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // Plano 12 — log de auditoria (Valor: completo; Assessor: simples)
    // ------------------------------------------------------------------
    match /auditoria/{docId} {
      allow read: if usuarioComAcesso()
                   && perfilUsuario().papel in
                       ['admin', 'owner', 'controle', 'transparencia', 'secom'];
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // Plano 14 — metricas por casa (so no ValorPublico; no Assessor a ALMT
    // e um escopo "cidade" como os demais)
    // ------------------------------------------------------------------
    match /metricas_por_casa/{docId} {
      allow read: if acessoPublico() || orgaoPermitido(docId);
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // Plano 19 — execucoes do navegador (log das sessoes)
    // ------------------------------------------------------------------
    match /execucoes_navegador/{docId} {
      allow read: if usuarioEhAdmin();
      allow write: if false;
    }

// ------------------------------------------------------------------
    // Plano 18/E2 — Governo de Mato Grosso (ValorPublico)
    // ------------------------------------------------------------------
    // Uma pasta por secretaria/autarquia do Executivo estadual.
    match /metricas_por_secretaria/{docId} {
      allow read: if acessoPublico()
        || usuarioEhAdmin()
        || orgaoDoUsuario() == 'governo-mt';
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // Controle de acesso
    // ------------------------------------------------------------------
    // Perfil do proprio usuario (mapeia uid -> agente).
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Administradores: leitura do perfil de qualquer usuario.
    match /owners/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Registro de execucao do motor de ingestao - apenas backend.
    match /execucoes_ingestao/{docId} {
      allow read, write: if false;
    }

    // Qualquer outra colecao: negada por padrao.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
